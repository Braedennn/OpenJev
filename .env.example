# OpenJev environment (optional fallbacks; the desktop UI stores the Jev key
# under Settings -> Models -> Jev, which is the preferred path).

# Jev (TypeSafe) API key — https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Local Jev bridge used by the OpenJev plugin
OPENJEV_DAEMON_URL=http://127.0.0.1:8931
OPENJEV_DAEMON_PORT=8931

# Optional tuning
# OPENJEV_AUTO_CONSULT=0              # disable per-step Jev consultation
# OPENJEV_INJECT=always|first|off     # when the decision is injected into the step
